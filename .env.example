# Vorlage für .env (lokal) bzw. die Environment Variables bei Vercel.
# Die echte .env NIE committen, sie steht in .gitignore.
#
# Keiner dieser Werte landet im Browser-Bundle: Der Browser bekommt keinen Key,
# er spricht nur mit /api. Vite reicht nur Variablen mit dem Präfix
# BLASTZONE_PUBLIC_ weiter (auch VITE_ ist abgeschaltet), und die Keys werden
# ausschließlich in api/ gelesen. Der Build bricht ab, falls doch ein Admin-Key
# im Bundle auftaucht.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# Publishable Key (sb_publishable_…). Bei älteren Projekten stattdessen SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Den Secret Key (sb_secret_…) bzw. service_role NICHT eintragen. Er wird nicht gebraucht und umgeht Row Level Security.
# Steht er versehentlich hier, lehnt der Server ihn ab und das Backend bleibt aus (Hinweis im Function-Log).

# Optional, für Rate Limiting über alle Vercel-Instanzen hinweg (Upstash → Redis → REST API).
# Ohne diese Werte zählt jede Instanz für sich.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# start.gg-Anbindung (Profil → Meine Turniere). Beides nur Server, nie mit Präfix.
# Token: start.gg → Settings → Developer Settings → Personal Access Tokens.
STARTGG_TOKEN=
# Schlüssel für die Signatur des Placement-Caches, mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STARTGG_CACHE_KEY=

# „Mit start.gg bestätigen“ (OAuth). start.gg → Settings → Developer Settings → OAuth → Create OAuth Application.
# Redirect URI dort exakt: https://blast-zone.vercel.app/api/startgg/callback  (ohne Schrägstrich am Ende)
# Scope nur user.identity. start.gg nimmt genau eine Redirect URI, lokal läuft der Login deshalb nicht gegen
# echtes start.gg. Ohne beide Werte simuliert der lokale Speicher-Mock den Login (api/_lib/startggOauth.ts).
# Das Secret geht nur im Körper des Token-Tauschs an start.gg, nie in eine URL, nie ins Log.
STARTGG_OAUTH_CLIENT_ID=
STARTGG_OAUTH_CLIENT_SECRET=
