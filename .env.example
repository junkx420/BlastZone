# Vorlage für .env (lokal) bzw. die Environment Variables bei Vercel.
# Die echte .env NIE committen, sie steht in .gitignore.
#
# Keiner dieser Werte landet im Browser-Bundle: Vite gibt nur Variablen mit
# dem Präfix VITE_ weiter, und die Keys werden ausschließlich in api/ gelesen.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# Publishable Key (sb_publishable_…). Bei älteren Projekten stattdessen SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Den Secret Key (sb_secret_…) bzw. service_role NICHT eintragen. Er wird nicht gebraucht und umgeht Row Level Security.

# Optional, für Rate Limiting über alle Vercel-Instanzen hinweg (Upstash → Redis → REST API).
# Ohne diese Werte zählt jede Instanz für sich.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
